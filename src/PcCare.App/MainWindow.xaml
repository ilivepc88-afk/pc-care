<Window x:Class="PcCare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcCare 系统优化工具"
        Width="1040"
        Height="720"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PcCare 系统优化工具" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="离线体检 · 安全启动项管理 · 本地报告 · 性能优化" Foreground="#607080" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="4" Padding="12,8">
                <TextBlock Text="{Binding AdministratorText}" />
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="计算机" Foreground="#607080" /><TextBlock Text="{Binding ComputerName}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="系统" Foreground="#607080" /><TextBlock Text="{Binding WindowsSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                <StackPanel><TextBlock Text="系统盘剩余" Foreground="#607080" /><TextBlock Text="{Binding SystemDriveFree}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="开始体检" Command="{Binding ScanCommand}" IsDefault="True" />
            <Button Content="停止扫描" Command="{Binding CancelCommand}" />
            <Button Content="导出报告" Command="{Binding ExportCommand}" />
        </StackPanel>

        <TabControl Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="系统概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Windows版本" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding WindowsDetails}" />
                        <TextBlock Grid.Row="1" Text="CPU" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuName}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Text="内存" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemorySummary}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="3" Text="系统盘" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriveSummary}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="4" Text="磁盘介质" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiskMediaType}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="5" Text="连续运行" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UptimeSummary}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="6" Text="待重启" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RebootPendingText}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="7" Text="说明" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="7" Grid.Column="1" Text="提供系统体检、启动项只读检查和视觉效果性能优化，不修改服务、更新、安全软件或用户文件。" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="性能优化">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="视觉效果性能模式" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="对应“系统属性 → 高级 → 性能 → 视觉效果”的自定义配置：仅保留平滑屏幕字体边缘，关闭其他视觉效果。"
                                   TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#526273" />

                        <Button Content="一键应用性能模式" Command="{Binding OptimizeVisualEffectsCommand}" MinWidth="150" HorizontalAlignment="Left" />
                        <TextBlock Text="仅修改当前 Windows 用户的视觉效果设置，不修改服务、驱动、电源计划或安全策略。部分效果在重新登录后完全生效。"
                                   TextWrapping="Wrap" Margin="0,14,0,0" Foreground="#8A5A13" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="启动项优化">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="安全启动项优化" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="只识别登录和开机入口；未知、系统、安全、驱动和企业管理项不会加入一键优化。" Foreground="#526273" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="扫描启动项" Command="{Binding ScanStartupCommand}" />
                            <Button Content="一键优化低风险项" Command="{Binding OptimizeStartupCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <WrapPanel Margin="0,0,0,8">
                            <Border Background="#EEF5FB" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding StartupItemCountText}" /></Border>
                            <Border Background="#EEF5FB" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding EnabledStartupItemCountText}" /></Border>
                            <Border Background="#EAF7EF" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding RecommendDisableCountText}" /></Border>
                            <Border Background="#FFF4E5" CornerRadius="3" Padding="10,5"><TextBlock Text="{Binding ProtectedStartupItemCountText}" /></Border>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding StartupFilters}" SelectedItem="{Binding StartupFilter}" Width="116" Margin="0,0,12,0" />
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,14,0" />
                            <CheckBox Content="显示 Microsoft Windows 系统计划任务（只读）" IsChecked="{Binding ShowMicrosoftSystemTasks}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding StartupItemsView}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="来源" Binding="{Binding SourceType}" Width="105" />
                            <DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="85" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="65" />
                            <DataGridTextColumn Header="建议" Binding="{Binding Recommendation}" Width="105" />
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="65" />
                            <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="130" />
                            <DataGridTextColumn Header="任务作者" Binding="{Binding User}" Width="120" />
                            <DataGridTextColumn Header="位置" Binding="{Binding SourcePath}" Width="220" />
                            <DataGridTextColumn Header="动作类型" Binding="{Binding ActionType}" Width="95" />
                            <DataGridTextColumn Header="命令/路径" Binding="{Binding Command}" Width="260" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="250" />
                            <DataGridTemplateColumn Header="操作" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="启用" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Content" Value="禁用" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="160" Height="12" IsIndeterminate="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</Window>
