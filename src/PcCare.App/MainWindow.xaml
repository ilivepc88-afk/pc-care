<Window x:Class="PcCare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PcCare 系统优化工具"
        Width="1040"
        Height="720"
        MinWidth="860"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PcCare 系统优化工具" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                <TextBlock Text="离线检查 · 安全启动项管理 · 后台优化 · 性能优化" Foreground="#607080" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="4" Padding="12,8">
                <TextBlock Text="{Binding AdministratorText}" />
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="计算机" Foreground="#607080" /><TextBlock Text="{Binding ComputerName}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="系统" Foreground="#607080" /><TextBlock Text="{Binding WindowsSummary}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14">
                <StackPanel><TextBlock Text="系统盘剩余" Foreground="#607080" /><TextBlock Text="{Binding SystemDriveFree}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="开始检查" Command="{Binding ScanCommand}" IsDefault="True" />
            <Button Content="停止检查" Command="{Binding CancelCommand}" />
        </StackPanel>

        <TabControl Grid.Row="3" Background="White" BorderBrush="{StaticResource BorderBrush}">
            <TabItem Header="系统概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Windows版本" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding WindowsDetails}" />
                        <TextBlock Grid.Row="1" Text="CPU" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CpuName}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="2" Text="内存" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MemorySummary}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="3" Text="系统盘" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DriveSummary}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="4" Text="磁盘介质" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DiskMediaType}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="5" Text="连续运行" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding UptimeSummary}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="6" Text="待重启" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding RebootPendingText}" Margin="0,12,0,0" />
                        <TextBlock Grid.Row="7" Text="说明" FontWeight="SemiBold" Margin="0,12,0,0" /><TextBlock Grid.Row="7" Grid.Column="1" Text="提供系统检查、保守启动项和后台优化、视觉效果性能优化；不修改服务、更新、安全软件或用户文件。" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="性能优化">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="860" HorizontalAlignment="Left">
                        <TextBlock Text="视觉效果性能模式" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        <TextBlock Text="请先执行“开始检查”。下表显示当前用户在“系统属性 → 高级 → 性能 → 视觉效果”中的实际读取结果。"
                                   TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#526273" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="应用性能模式" Command="{Binding OptimizeVisualEffectsCommand}" MinWidth="140" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" Text="仅修改当前 Windows 用户的视觉效果设置；保留字体平滑，其余视觉效果关闭。应用后会重新读取并刷新下表。"
                                       TextWrapping="Wrap" Margin="14,4,0,0" Foreground="#8A5A13" />
                        </Grid>
                        <DataGrid ItemsSource="{Binding VisualEffectSettings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="设置项" Binding="{Binding Name}" Width="230" />
                                <DataGridTextColumn Header="当前配置" Binding="{Binding CurrentValue}" Width="180" />
                                <DataGridTextColumn Header="性能模式建议" Binding="{Binding RecommendedValue}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="硬件与电源">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="硬件与电源" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="先读取硬件、供电与电源策略，再给出适配当前设备的建议；不会套用统一高性能方案。" Foreground="#526273" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="刷新" Command="{Binding RefreshHardwarePowerCommand}" />
                                <Button Content="一键推荐优化" Command="{Binding OptimizeRecommendedPowerCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="设备概况" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,8"><StackPanel><TextBlock Text="CPU" Foreground="#607080" /><TextBlock Text="{Binding HardwareCpuText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,8"><StackPanel><TextBlock Text="内存" Foreground="#607080" /><TextBlock Text="{Binding HardwareMemoryText}" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8"><StackPanel><TextBlock Text="系统盘" Foreground="#607080" /><TextBlock Text="{Binding HardwareDiskText}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="设备类型" Foreground="#607080" /><TextBlock Text="{Binding HardwareDeviceText}" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="电源状态" Foreground="#607080" /><TextBlock Text="{Binding HardwarePowerSourceText}" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10"><StackPanel><TextBlock Text="当前电源计划" Foreground="#607080" /><TextBlock Text="{Binding ActivePowerPlanText}" Margin="0,4,0,0" /></StackPanel></Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="#EEF5FB" CornerRadius="3" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="性能等级" Foreground="#607080" /><TextBlock Text="{Binding HardwarePerformanceText}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Grid.Column="1" Background="#FFF4E5" CornerRadius="3" Padding="10" Margin="0,0,8,0"><StackPanel><TextBlock Text="主要瓶颈" Foreground="#607080" /><TextBlock Text="{Binding HardwareBottleneckText}" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel></Border>
                            <Border Grid.Column="2" Background="#F7F9FB" CornerRadius="3" Padding="10"><TextBlock Text="{Binding HardwareAssessmentSummary}" TextWrapping="Wrap" /></Border>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="电源策略建议" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding RecommendedPowerOptimizationCountText}" Foreground="#18794E" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding PowerOptimizationItems}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="操作" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.TogglePowerOptimizationItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Content" Value="应用建议" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Id}" Value="power.restore-built-in-defaults"><Setter Property="Content" Value="恢复默认" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="150" />
                                        <DataGridTextColumn Header="当前" Binding="{Binding CurrentValue}" Width="100" />
                                        <DataGridTextColumn Header="建议" Binding="{Binding RecommendedValue}" Width="100" />
                                        <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="70" />
                                        <DataGridTextColumn Header="说明" Binding="{Binding Reason}" Width="260" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="硬件改善建议" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="仅供改善决策参考，本工具不会自动修改硬件或推荐具体采购型号。" Foreground="#526273" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding HardwareUpgradeRecommendations}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="250">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="70" />
                                        <DataGridTextColumn Header="建议" Binding="{Binding Name}" Width="160" />
                                        <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="300" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="执行记录（仅本次会话）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <DataGrid ItemsSource="{Binding PowerOptimizationLog}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="150" Margin="0,0,0,14">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="85" />
                                <DataGridTextColumn Header="项目" Binding="{Binding ItemName}" Width="160" />
                                <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="90" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Succeeded}" Width="70" />
                                <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="不会执行超频、BIOS/电压/TDP 调整、CPU 最小状态常驻高频、虚拟内存、休眠、USB、服务或安全功能修改。虚拟机、OEM 电源管理和组织策略会降级或锁定相关建议。" Foreground="#8A5A13" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="后台优化">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="后台优化" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="只关闭不必要的推荐内容和浏览器后台行为；不卸载组件、不修改服务、安全、更新或通知。" Foreground="#526273" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="扫描状态" Command="{Binding ScanBackgroundOptimizationCommand}" />
                            <Button Content="一键优化后台" Command="{Binding OptimizeBackgroundCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <WrapPanel Margin="0,0,0,8">
                            <Border Background="#EAF7EF" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding OptimizedBackgroundItemCountText}" /></Border>
                            <Border Background="#EEF5FB" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding RecommendedBackgroundItemCountText}" /></Border>
                            <Border Background="#FFF4E5" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding OptionalBackgroundItemCountText}" /></Border>
                            <Border Background="#F2F4F7" CornerRadius="3" Padding="10,5"><TextBlock Text="{Binding UnsupportedBackgroundItemCountText}" /></Border>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding BackgroundOptimizationFilters}" SelectedItem="{Binding BackgroundFilter}" Width="126" Margin="0,0,12,0" />
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding BackgroundSearchText, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding BackgroundOptimizationItemsView}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="操作" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleBackgroundOptimizationItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="优化" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentState}" Value="Disabled">
                                                            <Setter Property="Content" Value="恢复默认" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="160" />
                            <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="125" />
                            <DataGridTextColumn Header="当前状态" Binding="{Binding CurrentState}" Width="115" />
                            <DataGridTextColumn Header="建议" Binding="{Binding Recommendation}" Width="100" />
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="70" />
                            <DataGridTextColumn Header="注册表位置" Binding="{Binding RegistryPath}" Width="260" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="260" />
                            <DataGridTextColumn Header="影响说明" Binding="{Binding Impact}" Width="260" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="启动项优化">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="安全启动项优化" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="只识别登录和开机入口；未知、系统、安全、驱动和企业管理项不会加入一键优化。" Foreground="#526273" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="扫描启动项" Command="{Binding ScanStartupCommand}" />
                            <Button Content="一键优化低风险项" Command="{Binding OptimizeStartupCommand}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                        <WrapPanel Margin="0,0,0,8">
                            <Border Background="#EEF5FB" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding StartupItemCountText}" /></Border>
                            <Border Background="#EEF5FB" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding EnabledStartupItemCountText}" /></Border>
                            <Border Background="#EAF7EF" CornerRadius="3" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{Binding RecommendDisableCountText}" /></Border>
                            <Border Background="#FFF4E5" CornerRadius="3" Padding="10,5"><TextBlock Text="{Binding ProtectedStartupItemCountText}" /></Border>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding StartupFilters}" SelectedItem="{Binding StartupFilter}" Width="116" Margin="0,0,12,0" />
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Text="{Binding StartupSearchText, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,14,0" />
                            <CheckBox Content="显示 Microsoft Windows 系统计划任务（只读）" IsChecked="{Binding ShowMicrosoftSystemTasks}" VerticalAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding StartupItemsView}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="操作" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.ToggleStartupItemCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Content" Value="启用" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Content" Value="禁用" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150" />
                            <DataGridTextColumn Header="来源" Binding="{Binding SourceType}" Width="105" />
                            <DataGridTextColumn Header="范围" Binding="{Binding Scope}" Width="85" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="65" />
                            <DataGridTextColumn Header="建议" Binding="{Binding Recommendation}" Width="105" />
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="65" />
                            <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="130" />
                            <DataGridTextColumn Header="任务作者" Binding="{Binding User}" Width="120" />
                            <DataGridTextColumn Header="位置" Binding="{Binding SourcePath}" Width="220" />
                            <DataGridTextColumn Header="动作类型" Binding="{Binding ActionType}" Width="95" />
                            <DataGridTextColumn Header="命令/路径" Binding="{Binding Command}" Width="260" />
                            <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="250" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="160" Height="12" IsIndeterminate="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</Window>
